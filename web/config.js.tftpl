window.AWS_CONFIG = {
  region: "${region}",
  userPoolId: "${user_pool_id}",
  clientId: "${client_id}",
  apiBase: "/api",
  // Sign-in through AWS SSO; empty without it.
  authDomain: "${auth_domain}",
  ssoProvider: "${sso_provider}",
  // The name of the site in an authenticator app.
  issuer: ${issuer},
  demo: ${demo}
};
